---
import { SITE_CONFIG } from '../config/site';
---

<section class="relative pt-12 pb-20 sm:pt-16 sm:pb-28 md:pt-20 md:pb-32 overflow-hidden bg-white">
  <!-- Soft Ambient Glows (Apple Keynote Style) -->
  <div class="pointer-events-none absolute top-1/4 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[680px] h-[480px] bg-gradient-to-tr from-blue-100/50 via-sky-50/40 to-indigo-100/30 blur-3xl -z-10 rounded-full"></div>

  <div class="max-w-[1240px] mx-auto px-4 sm:px-6 lg:px-8 text-center">
    <!-- Top Eyebrow Badge -->
    <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-blue-50 border border-blue-100/80 text-[12px] sm:text-[13px] font-semibold text-[#0071E3] tracking-wider uppercase mb-6 reveal-item">
      <span class="w-1.5 h-1.5 rounded-full bg-[#0071E3] animate-pulse"></span>
      FAST · STABLE · GLOBAL
    </div>

    <!-- H1 Headline -->
    <h1 class="text-[38px] sm:text-[52px] md:text-[68px] lg:text-[72px] font-semibold tracking-[-0.03em] text-[#1D1D1F] leading-[1.08] max-w-4xl mx-auto mb-6 reveal-item">
      稳定连接世界，<br class="hidden sm:inline" />
      <span class="bg-clip-text text-transparent bg-gradient-to-r from-[#1D1D1F] via-[#1D1D1F] to-[#0071E3]">体验更快一步。</span>
    </h1>

    <!-- Subtitle -->
    <p class="text-[17px] sm:text-[19px] md:text-[21px] text-[#6E6E73] font-normal leading-relaxed max-w-2xl mx-auto mb-10 reveal-item">
      网际快车提供高速、稳定、低延迟的全球网络加速服务。<br class="hidden sm:inline" />
      无论工作、学习、影音娱乐，都能保持顺畅连接。
    </p>

    <!-- CTAs -->
    <div class="flex flex-col sm:flex-row items-center justify-center gap-4 sm:gap-5 mb-16 reveal-item">
      <a
        href={SITE_CONFIG.registerUrl}
        target="_blank"
        rel="nofollow sponsored noopener"
        class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-8 py-3.5 text-[16px] font-medium text-white bg-[#0071E3] hover:bg-[#0077ED] rounded-full transition-all duration-200 shadow-md hover:shadow-lg active:scale-95 group"
      >
        <span>立即体验</span>
        <svg class="w-4 h-4 transition-transform duration-200 group-hover:translate-x-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <line x1="5" y1="12" x2="19" y2="12"></line>
          <polyline points="12 5 19 12 12 19"></polyline>
        </svg>
      </a>

      <a
        href="#pricing"
        class="w-full sm:w-auto inline-flex items-center justify-center px-7 py-3.5 text-[16px] font-medium text-[#1D1D1F] hover:text-[#0071E3] bg-[#F5F5F7] hover:bg-[#E8E8ED] rounded-full transition-all duration-200 active:scale-95"
      >
        查看套餐 ↓
      </a>
    </div>

    <!-- Apple-style Hero Product Mockup / Glass Dashboard -->
    <div class="max-w-4xl mx-auto relative reveal-item">
      <!-- Outer Glass Device Frame -->
      <div class="rounded-3xl p-3 sm:p-5 bg-gradient-to-b from-white/90 to-slate-50/70 border border-black/[0.08] shadow-[0_25px_60px_-15px_rgba(0,113,227,0.12),0_12px_32px_rgba(0,0,0,0.06)] backdrop-blur-xl">
        
        <!-- Header Bar of the Device UI -->
        <div class="flex items-center justify-between px-3 sm:px-4 py-2.5 border-b border-black/[0.05] mb-4">
          <div class="flex items-center gap-2">
            <div class="flex gap-1.5">
              <div class="w-3 h-3 rounded-full bg-[#FF5F56]/80"></div>
              <div class="w-3 h-3 rounded-full bg-[#FFBD2E]/80"></div>
              <div class="w-3 h-3 rounded-full bg-[#27C93F]/80"></div>
            </div>
            <span class="ml-2 text-[12px] sm:text-[13px] font-semibold text-[#1D1D1F]">网际快车 · Network Controller</span>
          </div>

          <div class="flex items-center gap-2 px-3 py-1 rounded-full bg-emerald-50 border border-emerald-200/60 text-emerald-600 text-[12px] font-medium">
            <span class="w-2 h-2 rounded-full bg-emerald-500 animate-ping"></span>
            <span>已连接 (Connected)</span>
          </div>
        </div>

        <!-- Main Controller Body Grid -->
        <div class="grid grid-cols-1 md:grid-cols-12 gap-4 p-2 sm:p-4 text-left">
          
          <!-- Left Status & Switcher (5 Cols) -->
          <div class="md:col-span-5 flex flex-col justify-between bg-white rounded-2xl p-5 border border-black/[0.05] shadow-sm">
            <div>
              <div class="text-[12px] font-medium text-[#6E6E73] uppercase tracking-wider mb-1">当前路由节点</div>
              <div class="flex items-center justify-between mb-4">
                <div class="flex items-center gap-2.5">
                  <div class="w-9 h-9 rounded-xl bg-blue-50 border border-blue-100 flex items-center justify-center text-blue-600 font-bold text-sm">
                    HK
                  </div>
                  <div>
                    <h2 class="text-[16px] font-semibold text-[#1D1D1F]">香港 01 专线</h2>
                    <p class="text-[12px] text-[#6E6E73]">BGP 智能直连优化</p>
                  </div>
                </div>
                <span class="px-2.5 py-1 rounded-md bg-blue-50 text-[#0071E3] text-[12px] font-semibold">推荐</span>
              </div>

              <!-- Latency & Protocol Specs -->
              <div class="grid grid-cols-2 gap-2 mb-6">
                <div class="p-2.5 rounded-xl bg-[#F5F5F7]">
                  <div class="text-[11px] text-[#6E6E73]">实时延迟</div>
                  <div class="text-[17px] font-semibold text-[#0071E3]">18 ms</div>
                </div>
                <div class="p-2.5 rounded-xl bg-[#F5F5F7]">
                  <div class="text-[11px] text-[#6E6E73]">传输丢包率</div>
                  <div class="text-[17px] font-semibold text-emerald-600">0.0 %</div>
                </div>
              </div>
            </div>

            <!-- Central Glass Connect Action Button -->
            <div class="pt-4 border-t border-black/[0.05] flex items-center justify-between">
              <div class="flex items-center gap-3">
                <div class="w-10 h-10 rounded-full bg-gradient-to-tr from-[#0071E3] to-sky-400 flex items-center justify-center text-white shadow-md shadow-blue-500/20">
                  <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                    <path d="M18.36 6.64a9 9 0 1 1-12.73 0"></path>
                    <line x1="12" y1="2" x2="12" y2="12"></line>
                  </svg>
                </div>
                <div>
                  <div class="text-[13px] font-semibold text-[#1D1D1F]">智能连接已就绪</div>
                  <div class="text-[11px] text-[#6E6E73]">极速加密通道运行中</div>
                </div>
              </div>
            </div>
          </div>

          <!-- Right Global Node Matrix & World Topology (7 Cols) -->
          <div class="md:col-span-7 bg-[#F5F5F7] rounded-2xl p-5 border border-black/[0.04] flex flex-col justify-between">
            <div class="flex items-center justify-between mb-3">
              <div class="text-[13px] font-semibold text-[#1D1D1F]">全球优选节点快速切换</div>
              <div class="text-[11px] text-[#6E6E73]">自动负载均衡</div>
            </div>

            <!-- Node Quick Switch List -->
            <div class="space-y-2 mb-3">
              <div class="flex items-center justify-between px-3.5 py-2.5 rounded-xl bg-white border border-blue-200/80 shadow-xs">
                <div class="flex items-center gap-2.5">
                  <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
                  <span class="text-[13px] font-medium text-[#1D1D1F]">香港 (Hong Kong)</span>
                </div>
                <div class="flex items-center gap-3">
                  <span class="text-[12px] font-semibold text-[#0071E3]">18 ms</span>
                  <span class="text-[11px] text-[#6E6E73] bg-[#F5F5F7] px-2 py-0.5 rounded">主力专线</span>
                </div>
              </div>

              <div class="flex items-center justify-between px-3.5 py-2.5 rounded-xl bg-white/70 hover:bg-white border border-black/[0.04] transition-all">
                <div class="flex items-center gap-2.5">
                  <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
                  <span class="text-[13px] font-medium text-[#1D1D1F]">台湾 (Taiwan)</span>
                </div>
                <div class="flex items-center gap-3">
                  <span class="text-[12px] font-medium text-emerald-600">32 ms</span>
                  <span class="text-[11px] text-[#6E6E73] bg-[#F5F5F7] px-2 py-0.5 rounded">低延迟</span>
                </div>
              </div>

              <div class="flex items-center justify-between px-3.5 py-2.5 rounded-xl bg-white/70 hover:bg-white border border-black/[0.04] transition-all">
                <div class="flex items-center gap-2.5">
                  <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
                  <span class="text-[13px] font-medium text-[#1D1D1F]">日本 (Tokyo)</span>
                </div>
                <div class="flex items-center gap-3">
                  <span class="text-[12px] font-medium text-emerald-600">36 ms</span>
                  <span class="text-[11px] text-[#6E6E73] bg-[#F5F5F7] px-2 py-0.5 rounded">流媒体/游戏</span>
                </div>
              </div>

              <div class="flex items-center justify-between px-3.5 py-2.5 rounded-xl bg-white/70 hover:bg-white border border-black/[0.04] transition-all">
                <div class="flex items-center gap-2.5">
                  <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
                  <span class="text-[13px] font-medium text-[#1D1D1F]">新加坡 (Singapore)</span>
                </div>
                <div class="flex items-center gap-3">
                  <span class="text-[12px] font-medium text-emerald-600">48 ms</span>
                  <span class="text-[11px] text-[#6E6E73] bg-[#F5F5F7] px-2 py-0.5 rounded">东南亚优选</span>
                </div>
              </div>
            </div>

            <!-- Footer indicator -->
            <div class="flex items-center justify-between text-[11px] text-[#6E6E73] pt-2 border-t border-black/[0.04]">
              <span>全球 50+ 节点全自动测速并无缝漫游</span>
              <span class="font-medium text-[#0071E3]">智能模式开启</span>
            </div>
          </div>
        </div>

      </div>
    </div>
  </div>
</section>
