---
---

<section id="features" class="py-20 sm:py-28 md:py-32 bg-[#F5F5F7] relative">
  <div class="max-w-[1240px] mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header -->
    <div class="text-center max-w-3xl mx-auto mb-16 sm:mb-20">
      <div class="text-[13px] font-semibold text-[#0071E3] tracking-wider uppercase mb-3 reveal-item">
        为什么选择网际快车
      </div>
      <h2 class="text-[32px] sm:text-[44px] md:text-[52px] font-semibold text-[#1D1D1F] tracking-tight leading-[1.12] mb-5 reveal-item">
        速度，不只是快。<br />
        <span class="text-[#6E6E73]">稳定，才是真正的体验。</span>
      </h2>
      <p class="text-[16px] sm:text-[18px] text-[#6E6E73] leading-relaxed reveal-item">
        网际快车通过智能线路选择与全球节点部署，为用户提供更加稳定、流畅的网络连接体验。
      </p>
    </div>

    <!-- Apple-Style Bento Grid -->
    <div class="grid grid-cols-1 md:grid-cols-12 gap-6">
      
      <!-- Bento Card 1: Large Featured Card (7 cols) -->
      <div class="md:col-span-7 bg-white rounded-3xl p-8 sm:p-10 border border-black/[0.06] shadow-sm flex flex-col justify-between overflow-hidden relative group reveal-item">
        <div class="relative z-10">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-blue-50 text-[#0071E3] text-[12px] font-semibold mb-4">
            优质 BGP 专线
          </div>
          <h3 class="text-[28px] sm:text-[34px] font-semibold text-[#1D1D1F] tracking-tight leading-tight mb-3">
            让等待，<br />少一点。
          </h3>
          <p class="text-[15px] sm:text-[16px] text-[#6E6E73] max-w-md leading-relaxed">
            采用多线 BGP 骨干专线直连，大幅削减跨国路由跳数与网络拥塞，带来毫秒级即时响应。
          </p>
        </div>

        <!-- Visual Speed & Latency Comparison Bar -->
        <div class="mt-8 pt-8 border-t border-black/[0.05] relative z-10 space-y-4">
          <div>
            <div class="flex justify-between text-[13px] font-medium mb-1.5">
              <span class="text-[#1D1D1F] flex items-center gap-1.5">
                <span class="w-2 h-2 rounded-full bg-[#0071E3]"></span>
                网际快车 BGP 智能专线
              </span>
              <span class="text-[#0071E3] font-bold">18 ms</span>
            </div>
            <div class="w-full h-3 rounded-full bg-[#F5F5F7] overflow-hidden">
              <div class="h-full rounded-full bg-[#0071E3] w-[18%] transition-all duration-1000"></div>
            </div>
          </div>

          <div>
            <div class="flex justify-between text-[13px] font-medium text-[#6E6E73] mb-1.5">
              <span>普通公网中转线路</span>
              <span>180 ms ~ 320 ms</span>
            </div>
            <div class="w-full h-3 rounded-full bg-[#F5F5F7] overflow-hidden">
              <div class="h-full rounded-full bg-slate-300 w-[78%]"></div>
            </div>
          </div>
        </div>

        <!-- Ambient corner glow -->
        <div class="absolute -bottom-16 -right-16 w-56 h-56 bg-blue-100/40 rounded-full blur-2xl pointer-events-none"></div>
      </div>

      <!-- Bento Card 2: Realtime Low-Latency Card (5 cols) -->
      <div class="md:col-span-5 bg-white rounded-3xl p-8 sm:p-10 border border-black/[0.06] shadow-sm flex flex-col justify-between relative reveal-item" style="transition-delay: 100ms;">
        <div>
          <div class="w-10 h-10 rounded-2xl bg-emerald-50 border border-emerald-100 flex items-center justify-center text-emerald-600 mb-5">
            <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
              <polyline points="22 4 12 14.01 9 11.01"></polyline>
            </svg>
          </div>
          <h3 class="text-[22px] sm:text-[26px] font-semibold text-[#1D1D1F] tracking-tight mb-2">
            全时段极速稳定
          </h3>
          <p class="text-[14px] sm:text-[15px] text-[#6E6E73] leading-relaxed">
            全天候多重链路冗余，晚高峰无卡顿，保证全天候在线业务平稳畅通。
          </p>
        </div>

        <div class="mt-6 p-4 rounded-2xl bg-[#F5F5F7] border border-black/[0.04]">
          <div class="flex items-center justify-between text-[13px]">
            <span class="text-[#6E6E73]">可用性 SLA</span>
            <span class="font-bold text-[#1D1D1F]">99.9%</span>
          </div>
          <div class="flex items-center justify-between text-[13px] mt-2">
            <span class="text-[#6E6E73]">全链路丢包</span>
            <span class="font-bold text-emerald-600">&lt; 0.1%</span>
          </div>
          <div class="flex items-center justify-between text-[13px] mt-2">
            <span class="text-[#6E6E73]">网络状态</span>
            <span class="inline-flex items-center gap-1 font-semibold text-[#0071E3]">
              <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
              全部节点正常
            </span>
          </div>
        </div>
      </div>

      <!-- Bento Card 3: Intelligent Routing (5 cols) -->
      <div class="md:col-span-5 bg-white rounded-3xl p-8 sm:p-10 border border-black/[0.06] shadow-sm flex flex-col justify-between relative reveal-item" style="transition-delay: 150ms;">
        <div>
          <div class="w-10 h-10 rounded-2xl bg-indigo-50 border border-indigo-100 flex items-center justify-center text-indigo-600 mb-5">
            <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <circle cx="12" cy="12" r="10"></circle>
              <path d="m4.93 4.93 4.24 4.24"></path>
              <path d="m14.83 9.17 4.24-4.24"></path>
              <path d="m14.83 14.83 4.24 4.24"></path>
              <path d="m9.17 14.83-4.24 4.24"></path>
              <circle cx="12" cy="12" r="4"></circle>
            </svg>
          </div>
          <h3 class="text-[22px] sm:text-[26px] font-semibold text-[#1D1D1F] tracking-tight mb-2">
            智能路由优化
          </h3>
          <p class="text-[14px] sm:text-[15px] text-[#6E6E73] leading-relaxed">
            根据客户端所在地理位置与当前运营商网络状态，毫秒级动态匹配最优出口线路。
          </p>
        </div>

        <div class="mt-6 flex items-center gap-2 text-[12px] font-medium text-[#6E6E73]">
          <span class="px-2.5 py-1 rounded-lg bg-[#F5F5F7] text-[#1D1D1F]">自动测速</span>
          <span class="px-2.5 py-1 rounded-lg bg-[#F5F5F7] text-[#1D1D1F]">智能容灾</span>
          <span class="px-2.5 py-1 rounded-lg bg-[#F5F5F7] text-[#1D1D1F]">无感切换</span>
        </div>
      </div>

      <!-- Bento Card 4: Multi-platform & Security (7 cols) -->
      <div class="md:col-span-7 bg-white rounded-3xl p-8 sm:p-10 border border-black/[0.06] shadow-sm flex flex-col justify-between relative overflow-hidden reveal-item" style="transition-delay: 200ms;">
        <div>
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-slate-100 text-[#1D1D1F] text-[12px] font-semibold mb-4">
            全端兼容 · 安全加密
          </div>
          <h3 class="text-[24px] sm:text-[30px] font-semibold text-[#1D1D1F] tracking-tight mb-3">
            多设备互联，<br class="hidden sm:inline" />数据传输层层守护。
          </h3>
          <p class="text-[15px] text-[#6E6E73] max-w-lg leading-relaxed">
            支持手机、平板与电脑一键同步订阅配置。采用行业主流现代加密通信协议，保障公网 Wi-Fi 与移动网络下的连接私密性。
          </p>
        </div>

        <div class="mt-6 pt-6 border-t border-black/[0.05] grid grid-cols-3 gap-3 text-center">
          <div class="p-3 rounded-2xl bg-[#F5F5F7]">
            <div class="text-[13px] font-semibold text-[#1D1D1F]">多端即用</div>
            <div class="text-[11px] text-[#6E6E73] mt-0.5">iOS/Mac/Win/And</div>
          </div>
          <div class="p-3 rounded-2xl bg-[#F5F5F7]">
            <div class="text-[13px] font-semibold text-[#1D1D1F]">高强度加密</div>
            <div class="text-[11px] text-[#6E6E73] mt-0.5">端到端传输保护</div>
          </div>
          <div class="p-3 rounded-2xl bg-[#F5F5F7]">
            <div class="text-[13px] font-semibold text-[#1D1D1F]">隐私优先</div>
            <div class="text-[11px] text-[#6E6E73] mt-0.5">严格遵循规范</div>
          </div>
        </div>
      </div>

    </div>
  </div>
</section>
